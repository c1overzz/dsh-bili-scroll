# 这个插件包自己的 git 仓库 —— 只装插件本体，别装用户数据
node_modules/
.venv/
*.log
*.bak*
data/
credential*.json
seen_bvids.json
out/
log/

# 给你本机双击用的脚本（里面有本机绝对路径），不进仓库
*.cmd

# 跑 tools/check-vision.py 会生成
__pycache__/
*.pyc
style-probe-*/

# 排查/审查时临时抠出来的宿主源码、一次性脚本 —— 别进仓库
# （2026-10-24 审查点名：.tmp_llm.js 有 128KB，git add -A 会把宿主源码提交进来）
.tmp*
tmp-*
